# Copiez ce fichier en ".env.local" et remplissez les valeurs avant de lancer le site.

# Mot de passe de l'espace administrateur (à changer impérativement)
ADMIN_PASSWORD=changez-moi-admin-2026

# Clé secrète utilisée pour signer le cookie de session admin (chaîne aléatoire longue)
ADMIN_SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue-et-unique

# URL publique du site (utilisée pour le SEO : sitemap, Open Graph, données structurées)
NEXT_PUBLIC_SITE_URL=https://www.luxuriouspalace.ci
